{
  "name": "alterlab",
  "version": "2.5.6",
  "description": "Official Node.js and TypeScript client for AlterLab: search, read and extract the live web, with automatic fallback from direct fetch to full browser rendering. Pay only for successful requests.",
  "keywords": [
    "alterlab",
    "web-scraping",
    "web-data",
    "scraping-api",
    "typescript",
    "ai-agents",
    "llm",
    "search-api",
    "markdown",
    "headless-browser"
  ],
  "homepage": "https://alterlab.io/docs/sdk/node",
  "bugs": {
    "url": "https://github.com/RapierCraftStudios/alterlab-sdks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RapierCraftStudios/alterlab-sdks.git",
    "directory": "node"
  },
  "license": "MIT",
  "author": "AlterLab (https://alterlab.io)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "default": "./dist/crypto.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.10.4",
    "axios-mock-adapter": "^1.22.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.2"
  }
}
